<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>false</UseWindowsForms>

		<RootNamespace>NILUBRAIN.WPF</RootNamespace>
		<AssemblyName>NILUBRAIN.WPF</AssemblyName>

		<ApplicationIcon>Images\pg.ico</ApplicationIcon>

		<PlatformTarget>x64</PlatformTarget>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Images\pg.ico" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Images\pg.ico" />
	</ItemGroup>

	<!-- NuGet Packages -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />

		<PackageReference Include="AvalonEdit" Version="6.3.1.120" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
		<PackageReference Include="NAudio.WinMM" Version="2.2.1" />

		<PackageReference Include="System.Drawing.Common" Version="8.0.8" />
		<PackageReference Include="System.Speech" Version="8.0.0" />
		<PackageReference Include="PdfPig" Version="0.1.9" />
	</ItemGroup>

	<!-- API Project Reference -->
	<ItemGroup>
		<ProjectReference Include="..\NILUBRAIN.API\NILUBRAIN.API.csproj" />
	</ItemGroup>

	<!-- Image Resources -->
	<ItemGroup>
		<Resource Include="Images\back-image.jpg" />
		<Resource Include="Images\key-icon.png" />
		<Resource Include="Images\pg.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Images\pg.png" />
		<Resource Include="Images\user-icon.png" />
	</ItemGroup>

	<!-- Python Backend -->
	<ItemGroup>
		<None Update="PythonBackend\speech_listener.py">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- API Content -->
	<ItemGroup>
		<None Update="API\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>

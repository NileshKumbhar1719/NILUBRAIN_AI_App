<Window x:Class="NILUBRAIN.WPF.Views.InterviewAI.InterviewAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nilubrain AI"
        Width="510" Height="440"
        MinWidth="360" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">


    <Window.Resources>
        <!-- ToolButton Style -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#393939"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#222222"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Water / Sound Wave Animation for Audio Indicator -->
        <Storyboard x:Key="WaveAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="WaveBar1" Storyboard.TargetProperty="Height" From="4" To="14" Duration="0:0:0.3" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar2" Storyboard.TargetProperty="Height" From="12" To="4" Duration="0:0:0.4" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="WaveBar3" Storyboard.TargetProperty="Height" From="6" To="15" Duration="0:0:0.25" AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="18"
                            ShadowDepth="3"
                            Direction="270"
                            Color="#000000"
                            Opacity="0.45"/>
        </Grid.Effect>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main toolbar -->
        <Border Grid.Row="0"
                Background="#F02A2A2A"
                CornerRadius="12"
                Padding="5"
                Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🎙" Style="{StaticResource ToolButton}" Click="AudioToggle_Click" ToolTip="Toggle live meeting audio capture"/>
                    <Button Content="Answer" Style="{StaticResource ToolButton}" Click="Answer_Click" FontWeight="Bold" ToolTip="Send text or capture screen if empty"/>
                    <Button Content="📸 Screen" Style="{StaticResource ToolButton}" Click="Screenshot_Click" FontWeight="Bold" ToolTip="Capture and analyze screen with Vision AI"/>
                    <Button Content="💬 Chat" Style="{StaticResource ToolButton}" Click="Chat_Click" ToolTip="Type your question in the question box" FontWeight="Bold"/>
                    <!-- रंग नको असलेले Upload बटण (ToolButton स्टाईल वापरले आहे) -->
                    <Button Content="📄 Resume" Style="{StaticResource ToolButton}" Click="UploadResume_Click" ToolTip="Upload candidate resume (PDF or TXT)" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="−" Style="{StaticResource ToolButton}" Click="ZoomOut_Click" ToolTip="Decrease window size"/>
                    <Button Content="+" Style="{StaticResource ToolButton}" Click="ZoomIn_Click" ToolTip="Increase window size"/>
                    <Button Content="−D" Style="{StaticResource ToolButton}" Click="DarknessDown_Click" ToolTip="Make panel lighter"/>
                    <Button Content="+D" Style="{StaticResource ToolButton}" Click="DarknessUp_Click" ToolTip="Make panel darker"/>
                    <Button Content="End" Background="#E63946" Foreground="White" FontWeight="Bold" Style="{StaticResource ToolButton}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Question input with Parakeet Water/Sound Wave Indicator -->
        <Border Grid.Row="1"
                Background="#E82A2A2A"
                CornerRadius="10"
                Padding="6,5"
                Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="363*"/>
                    <ColumnDefinition Width="35*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Parakeet AI Audio Wave Lines -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0" Width="18" Height="16">
                    <Rectangle x:Name="WaveBar1" Width="3" Height="10" Fill="#70E000" RadiusX="1" RadiusY="1" Margin="1,0"/>
                    <Rectangle x:Name="WaveBar2" Width="3" Height="15" Fill="#00B4D8" RadiusX="1" RadiusY="1" Margin="1,0"/>
                    <Rectangle x:Name="WaveBar3" Width="3" Height="8" Fill="#FFD700" RadiusX="1" RadiusY="1" Margin="1,0"/>
                </StackPanel>

                <!-- TextBox -->
                <TextBox x:Name="TxtLiveAudio"
                         Grid.Column="1"
                         Text="Press F5 or click 🎙 to start meeting listener..."
                         Background="#303030"
                         Foreground="White"
                         CaretBrush="White"
                         SelectionBrush="#5577AA"
                         BorderThickness="0"
                         FontSize="11"
                         Padding="8,5"
                         VerticalContentAlignment="Center"
                         Margin="0,0,3,0"
                         KeyDown="TxtLiveAudio_KeyDown" FontWeight="Bold" Grid.ColumnSpan="2"/>

                <!-- Clear Button -->
                <Button Grid.Column="3" Content="Clear" Style="{StaticResource ToolButton}" Click="ClearLive_Click" FontWeight="Bold" Margin="2,0,2,0"/>
            </Grid>
        </Border>

        <!-- Answer panel -->
        <Border x:Name="AnswerPanel"
                Grid.Row="2"
                Background="#E8222222"
                BorderBrush="#555555"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Answer toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NILUBRAIN AI [STEALTH]" Foreground="#B8B8B8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Content="B" FontWeight="Bold" Style="{StaticResource ToolButton}" Click="Bold_Click" ToolTip="Toggle bold"/>
                        <Button Content="A−" Style="{StaticResource ToolButton}" Click="FontDown_Click" ToolTip="Smaller text"/>
                        <Button Content="A+" Style="{StaticResource ToolButton}" Click="FontUp_Click" ToolTip="Larger text"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Copy" Style="{StaticResource ToolButton}" Click="CopyAnswer_Click" FontWeight="Bold"/>
                        <Button Content="Clear" Style="{StaticResource ToolButton}" Click="ClearLive_Click" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- Scrollable content -->

                <!-- ChatGPT Style Scrollable Content -->
                <ScrollViewer x:Name="AnswerScroll"
              Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              CanContentScroll="False"
              PanningMode="VerticalOnly"
              IsDeferredScrollingEnabled="False"
              Background="Transparent"
              BorderThickness="0"
              Padding="2">

                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width" Value="6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#777777"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="Transparent"
                              Width="6">
                                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="#666666"
                                                        CornerRadius="4"
                                                        Margin="1,0"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>

                    <StackPanel>

                        <!-- Question -->
                        <TextBlock x:Name="TxtQuestion"
                   Foreground="White"
                   FontSize="13.5"
                   TextWrapping="Wrap"
                   Margin="0,3,0,8"
                   FontWeight="Bold"
                   FontFamily="Segoe UI Emoji, Segoe UI">
            <Run Text="💬 " Foreground="#00B4D8"/>
            <Run Text="Question: "
                 Foreground="White"
                 FontWeight="Bold"/>
            <Run Text="Ready for meeting audio capture (Press F5)."/>
                        </TextBlock>

                        <!-- Answer -->
                        <TextBlock x:Name="TxtAnswer"
                   Foreground="#E8E8E8"
                   FontSize="13"
                   TextWrapping="Wrap"
                   LineHeight="21"
                   FontWeight="Bold"
                   FontFamily="Segoe UI Emoji, Segoe UI">
            <Run Text="⭐ " Foreground="#FFD700"/>
            <Run Text="Answer: "
                 Foreground="White"
                 FontWeight="Bold"/>
            <Run Text="AI answers will stream here instantly word by word."/>
                        </TextBlock>

                    </StackPanel>
                </ScrollViewer>


                <!-- Footer -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatus" Text="Ready (Stealth Mode Active 🕵️‍♂️)" Foreground="#AAAAAA" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        <TextBlock x:Name="TxtTimestamp" Text=" · 00:00" Foreground="#888888" FontSize="10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="👍" Style="{StaticResource ToolButton}" Click="FeedbackUp_Click"/>
                        <Button Content="👎" Style="{StaticResource ToolButton}" Click="FeedbackDown_Click"/>
                        <Button Content="⤢" Style="{StaticResource ToolButton}" Click="Maximize_Click" ToolTip="Maximize / restore"/>
                        <Button Content="◐" Style="{StaticResource ToolButton}" Click="Settings_Click" ToolTip="Toggle opacity"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="+ / −: center size  ·  A+ / A−: text size  ·  F5: Toggle Listen  ·  Esc: Close"
                   Foreground="#888888"
                   FontSize="9"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,0"/>
    </Grid>
</Window>